{
  "name": "program-studio",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop program launcher and parameter workbench.",
  "author": "Program Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-client.mjs",
    "dev:web": "vite",
    "client": "npm run build:web && electron .",
    "package": "npm run build:web && electron-builder",
    "package:dir": "npm run build:web && electron-builder --dir",
    "build:web": "tsc --noEmit && vite build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "project:run": "node scripts/run-project.ts",
    "test": "node --test src/lib/variables.test.ts src/lib/launcher.test.ts src/lib/projectFolder.test.ts src/lib/projectExecution.test.ts src/lib/runRequest.test.ts src/lib/localExecutionAdapter.test.ts src/lib/theme.test.ts",
    "test:ui": "node scripts/run-ui-tests.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.local.programstudio",
    "productName": "Program Studio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-client"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
