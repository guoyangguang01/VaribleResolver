import math

phi = math.radians(0)
theta = math.radians(0)

sin_phi  = math.sin(phi)
cos_phi  = math.cos(phi)
sin_theta= math.sin(theta)
cos_theta= math.cos(theta)

az_x = - sin_theta * cos_phi
az_y = sin_phi
az_z = cos_theta * cos_phi

ccl = """LIBRARY: 
  COORDINATE FRAME DEFINITIONS: 
    &replace COORDINATE FRAME: Coord 1
      Axis 3 Point = {:.6f} [m], {:.6f} [m], {:.6f} [m]
      Coord Frame Type = Cartesian
      Option = Axis Points
      Origin Point = 0.0[m],0.0[m],0.0[m]
      Plane 13 Point = 1.0[m],0.0[m],0.0[m]
      Reference Coord Frame = Coord 0
      Render Data Error = off
      Visibility = on
    END
  END
END""".format(az_x, az_y, az_z)

ccl_out = r"J:\ST\AW\fa\fa1\GSP\jiaobencfx_coord.ccl"
with open(ccl_out, "w") as f:
    f.write(ccl)

setupComponentCFX = systemCFX.GetComponent(Name="Setup")
solutionComponentCFX = systemCFX.GetComponent(Name="Solution")

