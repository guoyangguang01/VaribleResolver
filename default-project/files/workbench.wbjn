SetScriptVersion(Version="19.5.112")

ccl_out = r"J:\ST\AW\fa\fa1\GSP\CFX_setup_0.ccl"

E1 = "Expression 1 = 3.6[MPa] + 2.4[MPa] * (1 - 2 * abs(mod(t / 0.5[s], 1) - 0.5))"
E2 = "Expression 2 = 12.5[kg s^-1] * (1 - 2 * abs(mod(t / 0.5[s], 1) - 0.5))"
E3 = "accelx = -30 * sin(pi * t / 0.04 [s]) * max(sin(pi * t / 0.04 [s]), 0) [m s^-2]"
E4 = "accelx15 = -15 * sin(pi * t / 0.04 [s]) * max(sin(pi * t / 0.04 [s]), 0) [m s^-2]"
E5 = "accelx5 = 5 * max(sin(pi * t / 0.4 [s]), 0) [m s^-2]"
E6 = "a = 0"
E7 = "a = 0"
    
# 第一行 71 个字符
cut_index = 71

length1 = len(E1)
length2 = len(E2)
length3 = len(E3)
length4 = len(E4)
length5 = len(E5)
length6 = len(E6)
length7 = len(E7)

# ctypes.windll.user32.MessageBoxW(0, str(length), "Len Result", 0)

if length1 > 71:
    E1 = E1[:cut_index] + "\\" + "\n        " + E1[cut_index:].lstrip()
if length2 > 71:
    E2 = E2[:cut_index] + "\\" + "\n        " + E2[cut_index:].lstrip()
if length3 > 71:
    E3 = E3[:cut_index] + "\\" + "\n        " + E3[cut_index:].lstrip()
if length4 > 71:
    E4 = E4[:cut_index] + "\\" + "\n        " + E4[cut_index:].lstrip()
if length5 > 71:
    E5 = E5[:cut_index] + "\\" + "\n        " + E5[cut_index:].lstrip()
if length6 > 71:
    E5 = E6[:cut_index] + "\\" + "\n        " + E5[cut_index:].lstrip()
if length7 > 71:
    E5 = E7[:cut_index] + "\\" + "\n        " + E5[cut_index:].lstrip()

ccl_content = """LIBRARY:
  CEL:
    EXPRESSIONS:
      %s
      %s
      %s
      %s
      %s
      %s
      %s
    END
  END
END""" % (E1, E2, E3, E4, E5, E6, E7)

# 保存文件
with open(ccl_out, "w") as f:
    f.write(ccl_content)

